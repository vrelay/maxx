{
  "expo": {
    "name": "maxx",
    "slug": "maxx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "maxx/src/assets/images/370670f68e95b6403e3d21f5896df023~tplv-tiktokx-cropcenter_1080_1080.jpeg",
    "scheme": "maxx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "fonts": [
      "maxx/src/assets/fonts/Plush-Trial-MediumItalic-BF654c40146661a.otf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.look.maxx",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:lookai.me",
        "applinks:www.lookai.me"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "This app needs access to camera to take photos for analysis",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select images for analysis",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.look.maxx",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "lookai.me"
            },
            {
              "scheme": "https",
              "host": "www.lookai.me"
            },
            {
              "scheme": "maxx"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "This app needs access to camera to take photos for analysis",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2301dbaf-d730-4f50-b119-7e4d8a1531d4"
      }
    }
  }
}
